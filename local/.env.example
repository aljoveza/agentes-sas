# Copy to local/.env.
# A Bedrock model id or inference profile your account can invoke, e.g. from:
#   aws bedrock list-inference-profiles --query 'inferenceProfileSummaries[].inferenceProfileId'
BEDROCK_MODEL_ID=deepseek.v3.2

# LocalStack is started by `lstk start` (your Hobby plan login). Override only if it runs elsewhere.
# LOCALSTACK_ENDPOINT=http://host.docker.internal:4566

# Optional: fixed access token for the MCP Inspector (--profile inspector), so its link stays the same.
# MCP_INSPECTOR_API_TOKEN=
