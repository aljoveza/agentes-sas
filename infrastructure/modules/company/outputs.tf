output "cluster_name" {
  value = aws_ecs_cluster.this.name
}

output "event_bus_name" {
  value = module.event_bus.name
}

output "audit_log_group" {
  value = module.event_bus.audit_log_group
}

output "table_name" {
  value = module.ledger.name
}

output "bucket_name" {
  value = module.documents.name
}

output "ecr_repositories" {
  value = { for key, repo in aws_ecr_repository.this : key => repo.repository_url }
}

output "urls" {
  description = "HTTPS URLs generated by ECS Express Mode. Only nexo is public."
  value = {
    nexo           = module.nexo.url
    company_mcp    = module.company_mcp.url
    agent_activity = module.agent_activity.url
  }
}

output "dashboard_url" {
  value = module.observability.dashboard_url
}

output "nexo_password_parameter" {
  value = module.nexo.password_parameter
}

output "mcp_audience" {
  value = local.mcp_audience
}

output "order_simulator_role_arn" {
  value = aws_iam_role.order_simulator.arn
}

output "inboxes" {
  description = "Queue and DLQ URLs per agent."
  value       = { for id, q in module.inbox : id => { queue = q.url, dlq = q.dlq_url } }
}

output "event_routes" {
  description = "Which events reach which agent."
  value       = local.event_routes
}
