output "service_name" {
  value = var.name
}

output "service_arn" {
  value = try(aws_ecs_express_gateway_service.this[0].service_arn, null)
}

output "url" {
  description = "HTTPS base URL generated by Express Mode (empty while the service is disabled)."
  value       = local.endpoint == "" ? "" : (startswith(local.endpoint, "https://") ? trimsuffix(local.endpoint, "/") : "https://${trimsuffix(local.endpoint, "/")}")
}

output "log_group" {
  value = aws_cloudwatch_log_group.this.name
}
